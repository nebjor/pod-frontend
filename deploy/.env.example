# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Public host; Caddy obtains the certificate for it and for www.
SITE_ADDRESS=3dburg.ch
ACME_EMAIL=info@3dburg.ch

# PostgreSQL (internal only, no published port)
DB_NAME=slicercore
DB_USERNAME=sliceruser
DB_PASSWORD=

# Owner login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Shown to customers who hit the quote rate limit
SUPPORT_EMAIL=info@3dburg.ch

# "mock" until the Stripe account is live: the payment page is a stand-in and no money flows.
# "stripe" needs both keys below (the backend refuses to start without them); see README.md.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Order mails over the Infomaniak mailbox; MAIL_ENABLED=false logs them instead of sending.
MAIL_ENABLED=false
SPRING_MAIL_HOST=mail.infomaniak.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=info@3dburg.ch
SPRING_MAIL_PASSWORD=
MAIL_FROM=info@3dburg.ch
OWNER_EMAIL=info@3dburg.ch

# Browsable API documentation at /api-docs (the JSON contract at /v3/api-docs stays on).
SWAGGER_UI_ENABLED=false
